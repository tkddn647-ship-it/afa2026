<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AFA Analysis</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
  <style>
    :root {
      --bg: #0b1220;
      --panel: #121a2b;
      --line: rgba(140, 170, 210, 0.18);
      --text: #e8eef8;
      --muted: #8fa3bf;
      --accent: #3db8ff;
      --ok: #34d399;
      --bad: #f87171;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(1200px 600px at 10% -10%, #15233a 0%, var(--bg) 55%);
      color: var(--text);
      font-family: "Segoe UI", system-ui, sans-serif;
    }
    .wrap {
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px;
    }
    header {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
    }
    h1 {
      margin: 0;
      font-size: 1.45rem;
      letter-spacing: 0.04em;
    }
    .sub { color: var(--muted); font-size: 0.9rem; margin-top: 4px; }
    .panel {
      background: color-mix(in srgb, var(--panel) 92%, black);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px;
    }
    .upload-row {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 12px;
      align-items: end;
      margin-bottom: 16px;
    }
    label.field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 0.82rem;
      color: var(--muted);
    }
    input[type="file"], input[type="range"], select {
      width: 100%;
      color: var(--text);
      background: #0a101c;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px;
    }
    button {
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      background: var(--accent);
      color: #041018;
      font-weight: 700;
      cursor: pointer;
    }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    button.ghost {
      background: transparent;
      color: var(--text);
      border: 1px solid var(--line);
    }
    .status {
      min-height: 1.2em;
      color: var(--muted);
      font-size: 0.88rem;
      margin: 8px 0 14px;
    }
    .status.err { color: var(--bad); }
    .status.ok { color: var(--ok); }
    .workspace {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 14px;
    }
    video {
      width: 100%;
      max-height: 420px;
      background: #000;
      border-radius: 12px;
      border: 1px solid var(--line);
    }
    .meta .sync-auto { color: var(--ok); }
    .meta .sync-manual { color: #fbbf24; }
    .sync-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-top: 10px;
    }
    .controls {
      display: grid;
      gap: 12px;
      margin-top: 12px;
    }
    .cols {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 6px 10px;
      max-height: 160px;
      overflow: auto;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: #0a101c;
    }
    .cols label {
      display: flex;
      gap: 6px;
      align-items: center;
      font-size: 0.8rem;
      color: var(--text);
    }
    .chart-wrap {
      position: relative;
      height: 280px;
    }
    .vehicle-section {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }
    .vehicle-wrap {
      position: relative;
      height: 340px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--line);
      background: linear-gradient(180deg, #0a1424 0%, #060b14 100%);
    }
    .vehicle-wrap canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
      cursor: grab;
      touch-action: none;
    }
    .vehicle-wrap canvas:active {
      cursor: grabbing;
    }
    .vehicle-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }
    .vehicle-toolbar .hint {
      margin-bottom: 0;
    }
    .vehicle-toolbar button {
      flex-shrink: 0;
      padding: 4px 10px;
      font-size: 0.72rem;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.04);
      color: var(--muted);
      cursor: pointer;
    }
    .vehicle-toolbar button:hover {
      color: var(--text);
      border-color: rgba(140, 170, 210, 0.35);
    }
    .vehicle-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin-top: 8px;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .vehicle-stats span strong {
      color: var(--text);
      font-weight: 600;
    }
    .hint { color: var(--muted); font-size: 0.8rem; }
    .pp-section {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }
    .pp-head {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .pp-badge {
      font-size: 0.78rem;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid var(--line);
      color: var(--muted);
    }
    .pp-badge.ready { color: var(--ok); border-color: rgba(52, 211, 153, 0.35); }
    .pp-badge.running, .pp-badge.pending { color: #fbbf24; border-color: rgba(251, 191, 36, 0.35); }
    .pp-badge.error { color: var(--bad); border-color: rgba(248, 113, 113, 0.35); }
    .kpi-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 12px;
      font-size: 0.76rem;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .kpi-strip span strong { color: var(--text); }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 8px;
      margin-bottom: 10px;
    }
    .kpi-card {
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.02);
      font-size: 0.74rem;
      color: var(--muted);
    }
    .kpi-card strong {
      display: block;
      color: var(--text);
      font-size: 0.95rem;
      margin-top: 2px;
    }
    .preset-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 8px;
    }
    .preset-row button {
      padding: 5px 10px;
      font-size: 0.72rem;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.03);
      color: var(--muted);
      cursor: pointer;
    }
    .preset-row button:hover,
    .preset-row button.active {
      color: var(--text);
      border-color: rgba(61, 184, 255, 0.4);
      background: rgba(61, 184, 255, 0.08);
    }
    .compare-row {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 8px;
      align-items: end;
      margin-bottom: 8px;
    }
    .compare-row select {
      width: 100%;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: #0a101c;
      color: var(--text);
      font-size: 0.78rem;
    }
    .compare-row button {
      padding: 7px 12px;
      font-size: 0.78rem;
      border-radius: 8px;
      border: 0;
      background: var(--accent);
      color: #041018;
      font-weight: 700;
      cursor: pointer;
    }
    .segments-list {
      max-height: 140px;
      overflow: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 8px;
    }
    .segment-item {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.02);
      font-size: 0.76rem;
      cursor: pointer;
      text-align: left;
    }
    .segment-item:hover { border-color: rgba(61, 184, 255, 0.35); }
    .segment-item.selected {
      border-color: rgba(52, 211, 153, 0.45);
      background: rgba(52, 211, 153, 0.08);
    }
    .events-tools {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .events-tools select {
      flex: 1;
      min-width: 120px;
      padding: 6px 8px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: #0a101c;
      color: var(--text);
      font-size: 0.78rem;
    }
    .events-list {
      max-height: 180px;
      overflow: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .event-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 10px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.02);
      cursor: pointer;
      font-size: 0.78rem;
      text-align: left;
    }
    .event-item:hover {
      border-color: rgba(61, 184, 255, 0.35);
      background: rgba(61, 184, 255, 0.06);
    }
    .event-item .etype {
      color: var(--accent);
      font-size: 0.7rem;
      min-width: 72px;
    }
    .event-item .elabel { flex: 1; color: var(--text); }
    .event-item .etime { color: var(--muted); font-variant-numeric: tabular-nums; }
    .vehicle-spec-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .vehicle-spec-head strong { font-size: 0.95rem; }
    .vehicle-spec-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }
    .vehicle-spec-grid label.field input[type="number"],
    .vehicle-spec-grid label.field input[type="text"] {
      padding: 8px 10px;
      border-radius: 8px;
    }
    .vehicle-spec-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
      align-items: center;
    }
    .vehicle-spec-actions .hint { margin: 0; flex: 1; min-width: 180px; }
    .vehicle-spec-actions .hint.ok { color: var(--ok); }
    .vehicle-spec-actions .hint.err { color: var(--bad); }
  details.vehicle-advanced {
      margin-top: 10px;
      border-top: 1px solid var(--line);
      padding-top: 10px;
    }
    details.vehicle-advanced summary {
      cursor: pointer;
      color: var(--muted);
      font-size: 0.82rem;
      margin-bottom: 8px;
    }
    @media (max-width: 980px) {
      .workspace, .upload-row { grid-template-columns: 1fr; }
      .vehicle-spec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div>
        <h1>AFA Analysis</h1>
        <div class="sub">CSV + 영상 업로드 · 차량 <span id="vehicleName">-</span></div>
      </div>
      <button type="button" class="ghost" id="clearBtn" disabled>세션 삭제</button>
    </header>

    <section class="panel" id="vehicleSpecPanel" style="margin-bottom:16px">
      <div class="vehicle-spec-head">
        <strong>차량 제원</strong>
        <button type="button" class="ghost" id="vehicleSpecToggle">접기</button>
      </div>
      <form id="vehicleSpecForm">
        <div class="vehicle-spec-grid">
          <label class="field">차량명
            <input type="text" id="vsName" autocomplete="off">
          </label>
          <label class="field">휠베이스 (m)
            <input type="number" id="vsWheelbase" step="0.01" min="0.5" max="10">
          </label>
          <label class="field">윤거 (m)
            <input type="number" id="vsTrack" step="0.01" min="0.5" max="5">
          </label>
          <label class="field">타이어 반경 (m)
            <input type="number" id="vsTireR" step="0.01" min="0.1" max="1">
          </label>
          <label class="field">조향비
            <input type="number" id="vsSteerRatio" step="0.1" min="1" max="40">
          </label>
          <label class="field">차량 질량 (kg)
            <input type="number" id="vsMass" step="1" min="100" max="5000">
          </label>
          <label class="field">리니어 중립 (mm)
            <input type="number" id="vsLinNeutral" step="0.1" min="0" max="500">
          </label>
          <label class="field">리니어 스케일
            <input type="number" id="vsLinScale" step="0.001" min="0" max="1">
          </label>
          <label class="field">피치 게인
            <input type="number" id="vsPitchGain" step="0.01" min="0" max="2">
          </label>
          <label class="field">롤 게인
            <input type="number" id="vsRollGain" step="0.01" min="0" max="2">
          </label>
          <label class="field">서스펜션 게인
            <input type="number" id="vsSusGain" step="0.01" min="0" max="3">
          </label>
        </div>
        <details class="vehicle-advanced">
          <summary>FSM / 고급 설정</summary>
          <div class="vehicle-spec-grid">
            <label class="field">정지 속도 (km/h)
              <input type="number" id="vsFsmStop" step="0.1" min="0" max="30">
            </label>
            <label class="field">코너 최소 속도 (km/h)
              <input type="number" id="vsFsmCornerSpd" step="0.1" min="0" max="80">
            </label>
            <label class="field">코너 최소 조향 (°)
              <input type="number" id="vsFsmCornerSteer" step="0.1" min="0" max="90">
            </label>
            <label class="field">코너 최소 횡G
              <input type="number" id="vsFsmCornerLatG" step="0.01" min="0" max="3">
            </label>
            <label class="field">제동 횡G
              <input type="number" id="vsFsmBrakeG" step="0.01" min="-3" max="0">
            </label>
            <label class="field">최소 구간 (s)
              <input type="number" id="vsFsmMinSeg" step="0.1" min="0.1" max="10">
            </label>
          </div>
        </details>
        <div class="vehicle-spec-actions">
          <button type="submit" id="vehicleSaveBtn">제원 저장</button>
          <button type="button" class="ghost" id="vehicleReprocessBtn" disabled>현재 세션 재분석</button>
          <span class="hint" id="vehicleSpecStatus">서버에 저장된 제원이 후처리·3D에 반영됩니다.</span>
        </div>
      </form>
    </section>

    <section class="panel">
      <form id="uploadForm" class="upload-row">
        <label class="field">CSV
          <input type="file" id="csvInput" name="csv_file" accept=".csv,text/csv" required>
        </label>
        <label class="field">영상
          <input type="file" id="videoInput" name="video_file" accept="video/*,.mp4,.avi,.webm,.mov,.mkv" required>
        </label>
        <button type="submit" id="uploadBtn">업로드</button>
      </form>
      <div class="status" id="status">CSV와 영상을 함께 업로드하세요. HUD 시간 글씨가 있으면 자동 동기화됩니다.</div>
    </section>

    <section class="workspace" id="workspace" hidden>
      <div class="panel">
        <video id="player" controls playsinline></video>
        <div class="meta">
          <span id="metaCsv">CSV: -</span>
          <span id="metaVideo">Video: -</span>
          <span id="metaRows">rows: -</span>
          <span id="metaDur">csv span: -</span>
          <span id="metaT0">t0: -</span>
          <span id="metaNow">t: 0.00s</span>
        </div>
        <div class="sync-row">
          <span id="syncBadge" class="sync-manual">동기화: 수동</span>
          <button type="button" class="ghost" id="autosyncBtn" disabled>자동 재동기화</button>
        </div>
        <div class="controls">
          <label class="field">시간 오프셋 (초) <span id="offsetLabel">0.0</span>
            <input type="range" id="offsetRange" min="-120" max="120" step="0.1" value="0">
          </label>
          <div class="hint" id="syncHint">영상 좌하단 HUD 시간이 없으면 슬라이더로 수동 조정하세요.</div>
          <label class="field">윈도우 (±초) <span id="windowLabel">15</span>
            <input type="range" id="windowRange" min="5" max="60" step="1" value="15">
          </label>
          <div>
            <div class="hint" style="margin-bottom:6px">그래프 컬럼 선택</div>
            <div class="cols" id="colList"></div>
          </div>
        </div>
        <div class="pp-section">
          <div class="pp-head">
            <span class="pp-badge pending" id="ppBadge">후처리: 대기</span>
            <div class="events-tools">
              <select id="eventFilter">
                <option value="">전체 이벤트</option>
                <option value="brake_peak">브레이크 피크</option>
                <option value="steer_peak">조향 피크</option>
                <option value="max_lat_g">횡G 피크</option>
                <option value="drive_start">주행 시작</option>
              </select>
            </div>
          </div>
          <div class="kpi-grid" id="kpiGrid"></div>
          <div class="kpi-strip" id="kpiStrip">KPI: 후처리 완료 후 표시</div>
          <div class="hint" style="margin-bottom:6px">차트 프리셋</div>
          <div class="preset-row" id="presetRow"></div>
          <div class="hint" style="margin-bottom:6px">코너 구간 · 클릭 시 이동 · 두 개 선택 후 비교</div>
          <div class="segments-list" id="segmentsList"></div>
          <div class="compare-row">
            <select id="compareA"></select>
            <select id="compareB"></select>
            <button type="button" id="compareBtn">비교</button>
          </div>
          <div class="hint" style="margin-bottom:6px">이벤트 클릭 → 해당 시점으로 이동</div>
          <div class="events-list" id="eventsList"></div>
        </div>
      </div>

      <div class="panel">
        <div class="hint" style="margin-bottom:8px">선택 센서 · 현재 재생 위치 기준 앞뒤 윈도우 (세로선 = now)</div>
        <div class="chart-wrap">
          <canvas id="chart"></canvas>
        </div>
        <div class="vehicle-section">
          <div class="vehicle-toolbar">
            <div class="hint">차량 자세 · 드래그 회전 · 휠 확대/축소 · 더블클릭 초기화</div>
            <button type="button" id="vehicleCamReset">카메라 초기화</button>
          </div>
          <div class="vehicle-wrap" id="vehicle3d"></div>
          <div class="vehicle-stats" id="vehicleStats">
            <span>속도 <strong id="vsSpeed">-</strong></span>
            <span>가속 <strong id="vsAccel">-</strong></span>
            <span>조향 <strong id="vsSteer">-</strong></span>
            <span>자세 <strong id="vsAttitude">-</strong></span>
            <span>리니어 <strong id="vsLinear">-</strong></span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const COLORS = ['#3db8ff', '#34d399', '#fbbf24', '#f87171', '#a78bfa', '#fb7185', '#2dd4bf', '#60a5fa'];
    let sessionId = '';
    let columns = [];
    let selected = new Set();
    let chart = null;
    let fetchTimer = null;
    let busy = false;
    let vehicleViz = null;
    let vehicleTarget = null;
    let vehicleDisplay = null;
    let ppTimer = null;
    let sessionT0 = 0;
    let sessionEvents = [];
    let sessionSegments = [];
    let chartPresets = {};
    let compareMode = false;
    let selectedSegmentIds = new Set();
    let vehicleSpec = null;

    function visCfg() {
      return (vehicleSpec && vehicleSpec.visualization) || {};
    }
    function linCfg() {
      return (vehicleSpec && vehicleSpec.linear_sensor) || {};
    }

    function updateVehicleHeader() {
      const name = (vehicleSpec && vehicleSpec.name) || '-';
      const wb = vehicleSpec && vehicleSpec.wheelbase_m;
      const tr = vehicleSpec && vehicleSpec.track_m;
      document.getElementById('vehicleName').textContent =
        name + (wb ? (' · WB ' + wb + 'm / TR ' + tr + 'm') : '');
    }

    function setVehicleSpecStatus(msg, kind) {
      const el = document.getElementById('vehicleSpecStatus');
      el.textContent = msg;
      el.className = 'hint' + (kind === 'err' ? ' err' : kind === 'ok' ? ' ok' : '');
    }

    function populateVehicleForm() {
      const v = vehicleSpec || {};
      const lin = v.linear_sensor || {};
      const vis = v.visualization || {};
      const fsm = v.fsm || {};
      document.getElementById('vsName').value = v.name || '';
      document.getElementById('vsWheelbase').value = v.wheelbase_m ?? '';
      document.getElementById('vsTrack').value = v.track_m ?? '';
      document.getElementById('vsTireR').value = v.tire_radius_m ?? '';
      document.getElementById('vsSteerRatio').value = v.steer_ratio ?? '';
      document.getElementById('vsMass').value = v.mass_kg ?? '';
      document.getElementById('vsLinNeutral').value = lin.neutral_mm ?? '';
      document.getElementById('vsLinScale').value = lin.visual_scale ?? '';
      document.getElementById('vsPitchGain').value = vis.pitch_gain ?? '';
      document.getElementById('vsRollGain').value = vis.roll_gain ?? '';
      document.getElementById('vsSusGain').value = vis.sus_gain ?? '';
      document.getElementById('vsFsmStop').value = fsm.stop_speed_kmh ?? '';
      document.getElementById('vsFsmCornerSpd').value = fsm.corner_min_speed_kmh ?? '';
      document.getElementById('vsFsmCornerSteer').value = fsm.corner_min_steer_deg ?? '';
      document.getElementById('vsFsmCornerLatG').value = fsm.corner_min_lat_g ?? '';
      document.getElementById('vsFsmBrakeG').value = fsm.long_brake_g ?? '';
      document.getElementById('vsFsmMinSeg').value = fsm.min_segment_sec ?? '';
    }

    function collectVehicleForm() {
      return {
        name: document.getElementById('vsName').value.trim(),
        wheelbase_m: Number(document.getElementById('vsWheelbase').value),
        track_m: Number(document.getElementById('vsTrack').value),
        tire_radius_m: Number(document.getElementById('vsTireR').value),
        steer_ratio: Number(document.getElementById('vsSteerRatio').value),
        mass_kg: Number(document.getElementById('vsMass').value),
        linear_sensor: {
          neutral_mm: Number(document.getElementById('vsLinNeutral').value),
          visual_scale: Number(document.getElementById('vsLinScale').value),
        },
        visualization: {
          pitch_gain: Number(document.getElementById('vsPitchGain').value),
          roll_gain: Number(document.getElementById('vsRollGain').value),
          sus_gain: Number(document.getElementById('vsSusGain').value),
        },
        fsm: {
          stop_speed_kmh: Number(document.getElementById('vsFsmStop').value),
          corner_min_speed_kmh: Number(document.getElementById('vsFsmCornerSpd').value),
          corner_min_steer_deg: Number(document.getElementById('vsFsmCornerSteer').value),
          corner_min_lat_g: Number(document.getElementById('vsFsmCornerLatG').value),
          long_brake_g: Number(document.getElementById('vsFsmBrakeG').value),
          min_segment_sec: Number(document.getElementById('vsFsmMinSeg').value),
        },
      };
    }

    function updateVehicleActionButtons() {
      document.getElementById('vehicleReprocessBtn').disabled = !sessionId;
    }

    async function loadVehicleSpec() {
      try {
        const data = await fetch('/api/vehicle', { cache: 'no-store' }).then((r) => r.json());
        if (!data.ok) return;
        vehicleSpec = data.vehicle || null;
        updateVehicleHeader();
        populateVehicleForm();
      } catch (err) {
        document.getElementById('vehicleName').textContent = '-';
      }
    }

    async function saveVehicleSpecFromForm() {
      const btn = document.getElementById('vehicleSaveBtn');
      btn.disabled = true;
      setVehicleSpecStatus('저장 중...');
      try {
        const res = await fetch('/api/vehicle', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(collectVehicleForm()),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          throw new Error(data.detail || data.message || '저장 실패');
        }
        vehicleSpec = data.vehicle || vehicleSpec;
        updateVehicleHeader();
        populateVehicleForm();
        destroyVehicleViz();
        ensureVehicleViz();
        if (vehicleViz && vehicleViz.resetWorld) vehicleViz.resetWorld();
        setVehicleSpecStatus(data.message || '차량 제원을 저장했습니다.', 'ok');
      } catch (err) {
        setVehicleSpecStatus('저장 실패: ' + (err.message || err), 'err');
      } finally {
        btn.disabled = false;
      }
    }

    async function reprocessCurrentSession() {
      if (!sessionId) return;
      const btn = document.getElementById('vehicleReprocessBtn');
      btn.disabled = true;
      setVehicleSpecStatus('현재 세션 재분석 중...');
      try {
        const res = await fetch('/api/session/' + sessionId + '/reprocess', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          throw new Error(data.detail || data.message || '재분석 실패');
        }
        updatePpBadge(data.postprocess || { status: 'pending' });
        document.getElementById('eventsList').innerHTML = '<div class="hint">후처리 중...</div>';
        document.getElementById('segmentsList').innerHTML = '<div class="hint">후처리 중...</div>';
        pollPostprocess();
        setVehicleSpecStatus('새 제원으로 후처리를 다시 시작했습니다.', 'ok');
      } catch (err) {
        setVehicleSpecStatus('재분석 실패: ' + (err.message || err), 'err');
      } finally {
        updateVehicleActionButtons();
      }
    }

    loadVehicleSpec();

    const EVENT_TYPE_LABEL = {
      brake_peak: '브레이크',
      steer_peak: '조향',
      max_lat_g: '횡G',
      drive_start: '출발',
    };

    const statusEl = document.getElementById('status');
    const player = document.getElementById('player');
    const workspace = document.getElementById('workspace');
    const offsetRange = document.getElementById('offsetRange');
    const windowRange = document.getElementById('windowRange');

    function setStatus(msg, kind) {
      statusEl.textContent = msg;
      statusEl.className = 'status' + (kind ? ' ' + kind : '');
    }

    function applyOffsetRange(offset, durationSec) {
      const span = Math.max(120, Number(durationSec || 0) + 60);
      const min = -Math.min(span, 600);
      const max = Math.min(span, 600);
      offsetRange.min = String(min);
      offsetRange.max = String(max);
      const clamped = Math.max(min, Math.min(max, Number(offset) || 0));
      offsetRange.value = String(clamped);
      document.getElementById('offsetLabel').textContent = clamped.toFixed(1);
    }

    function applySyncInfo(sync, durationSec) {
      const badge = document.getElementById('syncBadge');
      const hint = document.getElementById('syncHint');
      const offset = Number((sync && sync.offset_sec) || 0);
      applyOffsetRange(offset, durationSec);

      if (sync && sync.ok && sync.mode === 'auto') {
        badge.textContent = '동기화: 자동 (' + (sync.detected_clock || '?') + ')';
        badge.className = 'sync-auto';
        hint.textContent = sync.message || 'HUD 시간으로 CSV와 자동 맞춤.';
        return '자동 동기화 완료 · ' + (sync.message || 'HUD 시간 매칭');
      }

      badge.textContent = '동기화: 수동 조정 필요';
      badge.className = 'sync-manual';
      hint.textContent = (sync && sync.message)
        ? sync.message
        : '영상 좌하단 HUD 시간이 없으면 슬라이더로 수동 조정하세요.';
      return (sync && sync.message)
        ? '수동 동기화 필요 · ' + sync.message
        : '수동 동기화 필요 · HUD 시간을 찾지 못했습니다.';
    }

    function selectedCols() {
      return Array.from(selected);
    }

    function renderColumns(cols, keepSelection) {
      const box = document.getElementById('colList');
      box.innerHTML = '';
      columns = cols;
      if (!keepSelection || selected.size === 0) {
        const preferred = ['speed', 'steering_angle', 'pitch_deg', 'roll_deg', 'break_p', 'accelX'];
        const picks = preferred.filter((c) => cols.includes(c));
        selected = new Set((picks.length ? picks : cols).slice(0, Math.min(4, cols.length)));
      } else {
        const next = new Set();
        selected.forEach((col) => {
          if (cols.includes(col)) next.add(col);
        });
        selected = next.size ? next : new Set(cols.slice(0, Math.min(4, cols.length)));
      }
      cols.forEach((col) => {
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = col;
        input.checked = selected.has(col);
        input.addEventListener('change', () => {
          if (input.checked) selected.add(col);
          else selected.delete(col);
          scheduleRefresh(true);
        });
        label.appendChild(input);
        label.appendChild(document.createTextNode(col));
        box.appendChild(label);
      });
    }

    function updatePpBadge(pp) {
      const badge = document.getElementById('ppBadge');
      const status = (pp && pp.status) || 'unknown';
      const labels = {
        pending: '후처리: 대기',
        running: '후처리: 분석 중...',
        ready: '후처리: 완료',
        error: '후처리: 실패',
        unknown: '후처리: -',
      };
      badge.textContent = labels[status] || labels.unknown;
      badge.className = 'pp-badge ' + status;
      if (status === 'ready' && pp.elapsed_sec != null) {
        badge.textContent += ' (' + Number(pp.elapsed_sec).toFixed(1) + 's)';
      }
      if (status === 'error' && pp.message) {
        badge.title = pp.message;
      }
    }

    function renderKpi(kpi) {
      const strip = document.getElementById('kpiStrip');
      const grid = document.getElementById('kpiGrid');
      grid.innerHTML = '';
      if (!kpi) {
        strip.textContent = 'KPI: 후처리 완료 후 표시';
        return;
      }
      const cards = [
        ['주행거리', (kpi.distance_km || 0).toFixed(2) + ' km'],
        ['최고속', (kpi.speed && kpi.speed.max || 0).toFixed(1) + ' km/h'],
        ['평균속', (kpi.speed && kpi.speed.avg || 0).toFixed(1) + ' km/h'],
        ['최대 횡G', (kpi.g && kpi.g.lat_max || 0).toFixed(2) + 'g'],
        ['최대 제동G', (kpi.g && kpi.g.long_brake_min || 0).toFixed(2) + 'g'],
        ['코너 수', String((kpi.segments && kpi.segments.corners) || 0)],
        ['제동 구간', String((kpi.segments && kpi.segments.brakes) || 0)],
        ['피크 출력', (kpi.powertrain && kpi.powertrain.peak_power_kw || 0).toFixed(1) + ' kW'],
        ['최대 조향', (kpi.steering && kpi.steering.max_abs_deg || 0).toFixed(0) + '°'],
        ['이벤트', String(kpi.event_total || 0)],
      ];
      cards.forEach(([label, value]) => {
        const card = document.createElement('div');
        card.className = 'kpi-card';
        card.innerHTML = label + '<strong>' + value + '</strong>';
        grid.appendChild(card);
      });
      strip.textContent =
        '샘플링 ' + (kpi.sample_hz || '-') + ' Hz · 후처리 캐시 ' +
        (kpi.row_count ? Math.round((kpi.row_count || 0) / (kpi.sample_hz || 200)) + 's' : '-') +
        ' · 구간 ' + ((kpi.segments && kpi.segments.total) || 0) + '개';
    }

    function renderPresets(presets) {
      chartPresets = presets || {};
      const row = document.getElementById('presetRow');
      row.innerHTML = '';
      Object.keys(chartPresets).forEach((key) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = key;
        btn.addEventListener('click', () => {
          const cols = (chartPresets[key] || []).filter((c) => columns.includes(c));
          if (!cols.length) return;
          selected = new Set(cols);
          compareMode = false;
          renderColumns(columns, true);
          row.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          scheduleRefresh(true);
        });
        row.appendChild(btn);
      });
    }

    function fillCompareSelects() {
      const pool = sessionSegments.filter((s) =>
        (s.state === 'corner' || s.state === 'brake') && Number(s.duration_sec || 0) >= 1.5
      );
      const selA = document.getElementById('compareA');
      const selB = document.getElementById('compareB');
      const opts = '<option value="">구간 선택</option>' +
        pool.map((s) => '<option value="' + s.id + '">' + s.label + ' (' + s.duration_sec + 's)</option>').join('');
      selA.innerHTML = opts;
      selB.innerHTML = opts;
      if (pool.length >= 2) {
        selA.value = pool[0].id;
        selB.value = pool[1].id;
      }
    }

    function renderSegments(segments) {
      sessionSegments = segments || [];
      const list = document.getElementById('segmentsList');
      list.innerHTML = '';
      const shown = sessionSegments.filter((s) => s.state === 'corner' || s.state === 'brake').slice(0, 40);
      if (!shown.length) {
        list.innerHTML = '<div class="hint">코너/제동 구간 없음</div>';
        fillCompareSelects();
        return;
      }
      shown.forEach((seg) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'segment-item' + (selectedSegmentIds.has(seg.id) ? ' selected' : '');
        const stats = seg.stats || {};
        btn.innerHTML =
          '<span>' + seg.label + ' · ' + (stats.speed_min || '-') + '→' + (stats.speed_max || '-') + ' km/h</span>' +
          '<span>' + (seg.t_start_rel || 0).toFixed(1) + 's</span>';
        btn.addEventListener('click', () => {
          if (selectedSegmentIds.has(seg.id)) {
            selectedSegmentIds.delete(seg.id);
          } else {
            if (selectedSegmentIds.size >= 2) {
              const first = selectedSegmentIds.values().next().value;
              selectedSegmentIds.delete(first);
            }
            selectedSegmentIds.add(seg.id);
          }
          renderSegments(sessionSegments);
          const picked = Array.from(selectedSegmentIds);
          if (picked.length >= 1) document.getElementById('compareA').value = picked[0] || '';
          if (picked.length >= 2) document.getElementById('compareB').value = picked[1] || '';
        });
        btn.addEventListener('dblclick', () => {
          const offset = Number(offsetRange.value || 0);
          player.currentTime = Math.max(0, Number(seg.t_start_rel || 0) - offset);
          player.pause();
          scheduleRefresh(true);
        });
        list.appendChild(btn);
      });
      fillCompareSelects();
    }

    async function loadSegments() {
      if (!sessionId) return;
      try {
        const data = await fetch('/api/session/' + sessionId + '/segments', { cache: 'no-store' })
          .then((r) => r.json());
        if (!data.ok) return;
        renderSegments(data.segments || []);
      } catch (err) {}
    }

    async function runCompare() {
      const a = document.getElementById('compareA').value;
      const b = document.getElementById('compareB').value;
      if (!a || !b || a === b) {
        setStatus('비교할 서로 다른 코너 구간 두 개를 선택하세요.', 'err');
        return;
      }
      const cols = selectedCols().length ? selectedCols() : ['speed', 'steering_angle', 'lat_g'];
      try {
        const url = '/api/session/' + sessionId + '/compare'
          + '?a=' + encodeURIComponent(a)
          + '&b=' + encodeURIComponent(b)
          + '&cols=' + encodeURIComponent(cols.join(','));
        const data = await fetch(url, { cache: 'no-store' }).then((r) => r.json());
        if (!data.ok) throw new Error(data.detail || 'compare failed');
        compareMode = true;
        const c = ensureChart();
        const xs = data.x_pct || [];
        const series = data.series || {};
        const datasets = [];
        let colorIdx = 0;
        cols.forEach((col) => {
          if (!series[col]) return;
          const color = COLORS[colorIdx % COLORS.length];
          colorIdx += 1;
          datasets.push({
            label: col + ' · ' + (data.segment_a && data.segment_a.label || 'A'),
            data: xs.map((x, idx) => ({ x, y: series[col].a[idx] })),
            borderColor: color,
            backgroundColor: 'transparent',
            borderWidth: 2,
            pointRadius: 0,
            tension: 0.15,
            spanGaps: true,
          });
          datasets.push({
            label: col + ' · ' + (data.segment_b && data.segment_b.label || 'B'),
            data: xs.map((x, idx) => ({ x, y: series[col].b[idx] })),
            borderColor: color,
            backgroundColor: 'transparent',
            borderWidth: 2,
            borderDash: [6, 4],
            pointRadius: 0,
            tension: 0.15,
            spanGaps: true,
          });
        });
        c.data.datasets = datasets;
        c.options.scales.x.min = 0;
        c.options.scales.x.max = 100;
        c.options.scales.x.title.text = '구간 진행률 (%)';
        c.update('none');
        setStatus(
          '구간 비교: ' + (data.segment_a && data.segment_a.label) + ' vs ' + (data.segment_b && data.segment_b.label),
          'ok'
        );
      } catch (err) {
        setStatus('구간 비교 실패: ' + (err.message || err), 'err');
      }
    }

    document.getElementById('compareBtn').addEventListener('click', runCompare);

    function eventVideoTime(evt) {
      const offset = Number(offsetRange.value || 0);
      return Math.max(0, Number(evt.t_rel || 0) - offset);
    }

    function renderEvents(events) {
      const list = document.getElementById('eventsList');
      const filter = document.getElementById('eventFilter').value;
      const filtered = filter
        ? events.filter((evt) => evt.type === filter)
        : events;
      list.innerHTML = '';
      if (!filtered.length) {
        list.innerHTML = '<div class="hint">표시할 이벤트가 없습니다.</div>';
        return;
      }
      filtered.forEach((evt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'event-item';
        const videoT = eventVideoTime(evt);
        btn.innerHTML =
          '<span class="etype">' + (EVENT_TYPE_LABEL[evt.type] || evt.type) + '</span>' +
          '<span class="elabel">' + (evt.label || '-') + '</span>' +
          '<span class="etime">' + videoT.toFixed(1) + 's</span>';
        btn.addEventListener('click', () => {
          player.currentTime = videoT;
          player.pause();
          scheduleRefresh(true);
        });
        list.appendChild(btn);
      });
    }

    async function loadEvents() {
      if (!sessionId) return;
      try {
        const filter = document.getElementById('eventFilter').value;
        const url = '/api/session/' + sessionId + '/events'
          + (filter ? ('?type=' + encodeURIComponent(filter)) : '');
        const data = await fetch(url, { cache: 'no-store' }).then((r) => r.json());
        if (!data.ok) return;
        sessionEvents = data.events || [];
        renderEvents(sessionEvents);
      } catch (err) {
        // best-effort
      }
    }

    async function pollPostprocess() {
      if (!sessionId) return;
      if (ppTimer) clearTimeout(ppTimer);
      try {
        const data = await fetch('/api/session/' + sessionId, { cache: 'no-store' }).then((r) => r.json());
        if (!data.ok) return;
        sessionT0 = Number(data.t0 || 0);
        updatePpBadge(data.postprocess || {});
        renderKpi(data.kpi || null);
        if (data.postprocess && data.postprocess.status === 'ready') {
          if (data.columns && data.columns.length) {
            renderColumns(data.columns, true);
          }
          renderPresets(data.chart_presets || (data.kpi && data.kpi.chart_presets) || {});
          await loadEvents();
          await loadSegments();
          scheduleRefresh(true);
          return;
        }
        if (data.postprocess && (data.postprocess.status === 'pending' || data.postprocess.status === 'running')) {
          ppTimer = setTimeout(pollPostprocess, 700);
        }
      } catch (err) {
        ppTimer = setTimeout(pollPostprocess, 1200);
      }
    }

    document.getElementById('eventFilter').addEventListener('change', () => {
      renderEvents(sessionEvents);
      loadEvents();
    });

    function ensureChart() {
      if (chart) return chart;
      const ctx = document.getElementById('chart').getContext('2d');
      chart = new Chart(ctx, {
        type: 'line',
        data: { datasets: [] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false,
          interaction: { mode: 'nearest', intersect: false },
          plugins: {
            legend: { labels: { color: '#c9d7ea' } },
            tooltip: {
              callbacks: {
                title: (items) => {
                  if (!items.length) return '';
                  const x = items[0].parsed.x;
                  return (x >= 0 ? '+' : '') + x.toFixed(2) + 's';
                },
              },
            },
          },
          scales: {
            x: {
              type: 'linear',
              title: { display: true, text: '상대 시간 (s)', color: '#8fa3bf' },
              ticks: { color: '#8fa3bf' },
              grid: { color: 'rgba(140,170,210,0.12)' },
            },
            y: {
              ticks: { color: '#8fa3bf' },
              grid: { color: 'rgba(140,170,210,0.12)' },
            },
          },
        },
        plugins: [{
          id: 'nowLine',
          afterDraw(c) {
            const xScale = c.scales.x;
            const yScale = c.scales.y;
            if (!xScale || !yScale) return;
            const x = xScale.getPixelForValue(0);
            const ctx2 = c.ctx;
            ctx2.save();
            ctx2.strokeStyle = 'rgba(255,255,255,0.75)';
            ctx2.lineWidth = 1.5;
            ctx2.setLineDash([4, 4]);
            ctx2.beginPath();
            ctx2.moveTo(x, yScale.top);
            ctx2.lineTo(x, yScale.bottom);
            ctx2.stroke();
            ctx2.restore();
          },
        }],
      });
      return chart;
    }

    async function refreshWindow(force) {
      if (!sessionId || busy) return;
      if (compareMode) return;
      const cols = selectedCols();
      if (!cols.length) return;
      busy = true;
      try {
        const t = player.currentTime || 0;
        const offset = Number(offsetRange.value || 0);
        const windowSec = Number(windowRange.value || 15);
        document.getElementById('metaNow').textContent = 't: ' + t.toFixed(2) + 's';
        const url = '/api/session/' + sessionId + '/window'
          + '?t=' + encodeURIComponent(t)
          + '&offset=' + encodeURIComponent(offset)
          + '&window=' + encodeURIComponent(windowSec)
          + '&cols=' + encodeURIComponent(cols.join(','));
        const data = await fetch(url, { cache: 'no-store' }).then((r) => r.json());
        if (!data.ok) throw new Error(data.detail || 'window failed');

        const c = ensureChart();
        const xs = data.x || [];
        c.data.datasets = cols.map((col, i) => {
          const ys = (data.series && data.series[col]) || [];
          return {
            label: col,
            data: xs.map((x, idx) => ({ x, y: ys[idx] })),
            borderColor: COLORS[i % COLORS.length],
            backgroundColor: 'transparent',
            borderWidth: 2,
            pointRadius: 0,
            tension: 0.15,
            spanGaps: true,
          };
        });
        const half = Number(data.window_sec || windowSec);
        c.options.scales.x.min = -half;
        c.options.scales.x.max = half;
        c.options.scales.x.title.text = '상대 시간 (s)';
        c.update(force ? 'none' : undefined);
      } catch (err) {
        setStatus('그래프 갱신 실패: ' + (err.message || err), 'err');
      } finally {
        busy = false;
      }
    }

    function scheduleRefresh(force) {
      if (fetchTimer) clearTimeout(fetchTimer);
      fetchTimer = setTimeout(() => {
        refreshWindow(force);
        refreshVehicle();
      }, force ? 20 : 60);
    }

    function numOr(value, fallback) {
      const n = Number(value);
      return Number.isFinite(n) ? n : fallback;
    }

    function ensureVehicleViz() {
      if (vehicleViz || !window.THREE) return vehicleViz;
      const host = document.getElementById('vehicle3d');
      if (!host) return null;

      // 차량 좌표계: X=전방, Y=좌(뒤에서 봤을 때), Z=상
      const USER_X = new THREE.Vector3(0, 0, 1);
      const USER_Y = new THREE.Vector3(-1, 0, 0);
      const USER_Z = new THREE.Vector3(0, 1, 0);

      function userToThree(x, y, z) {
        return new THREE.Vector3(-y, z, x);
      }

      function setUserPosition(obj, x, y, z) {
        obj.position.copy(userToThree(x, y, z));
      }

      function quatFromUserEuler(pitch, roll, yaw) {
        const qPitch = new THREE.Quaternion().setFromAxisAngle(USER_Y, pitch);
        const qRoll = new THREE.Quaternion().setFromAxisAngle(USER_X, roll);
        const qYaw = new THREE.Quaternion().setFromAxisAngle(USER_Z, yaw);
        return qYaw.multiply(qRoll).multiply(qPitch);
      }

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x060b14);

      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
      const defaultCamPos = userToThree(0.2, -2.2, 1.45);
      const orbitTarget = userToThree(0.35, 0, 0.34);
      camera.position.copy(defaultCamPos);
      camera.lookAt(orbitTarget);

      function createOrbitControls(cam, domElement, target, defaultPosition) {
        const state = {
          target: target.clone(),
          spherical: new THREE.Spherical(),
          rotating: false,
          lastX: 0,
          lastY: 0,
          minRadius: 2.8,
          maxRadius: 13,
        };
        const offset = new THREE.Vector3().subVectors(cam.position, state.target);
        state.spherical.setFromVector3(offset);

        function apply() {
          state.spherical.phi = THREE.MathUtils.clamp(state.spherical.phi, 0.22, Math.PI - 0.22);
          state.spherical.radius = THREE.MathUtils.clamp(
            state.spherical.radius,
            state.minRadius,
            state.maxRadius
          );
          offset.setFromSpherical(state.spherical);
          cam.position.copy(state.target).add(offset);
          cam.lookAt(state.target);
        }

        function onPointerDown(e) {
          if (e.button !== 0) return;
          state.rotating = true;
          state.lastX = e.clientX;
          state.lastY = e.clientY;
          domElement.setPointerCapture(e.pointerId);
        }
        function onPointerMove(e) {
          if (!state.rotating) return;
          const dx = e.clientX - state.lastX;
          const dy = e.clientY - state.lastY;
          state.lastX = e.clientX;
          state.lastY = e.clientY;
          state.spherical.theta -= dx * 0.005;
          state.spherical.phi -= dy * 0.005;
          apply();
        }
        function onPointerUp(e) {
          state.rotating = false;
          try { domElement.releasePointerCapture(e.pointerId); } catch (_) {}
        }
        function onWheel(e) {
          e.preventDefault();
          state.spherical.radius += e.deltaY * 0.008;
          apply();
        }
        function onDblClick() {
          cam.position.copy(defaultPosition);
          offset.subVectors(cam.position, state.target);
          state.spherical.setFromVector3(offset);
          apply();
        }

        domElement.addEventListener('pointerdown', onPointerDown);
        domElement.addEventListener('pointermove', onPointerMove);
        domElement.addEventListener('pointerup', onPointerUp);
        domElement.addEventListener('pointercancel', onPointerUp);
        domElement.addEventListener('wheel', onWheel, { passive: false });
        domElement.addEventListener('dblclick', onDblClick);

        return {
          reset: onDblClick,
          dispose() {
            domElement.removeEventListener('pointerdown', onPointerDown);
            domElement.removeEventListener('pointermove', onPointerMove);
            domElement.removeEventListener('pointerup', onPointerUp);
            domElement.removeEventListener('pointercancel', onPointerUp);
            domElement.removeEventListener('wheel', onWheel);
            domElement.removeEventListener('dblclick', onDblClick);
          },
        };
      }

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.shadowMap.enabled = true;
      host.appendChild(renderer.domElement);
      const orbit = createOrbitControls(camera, renderer.domElement, orbitTarget, defaultCamPos);
      const camResetBtn = document.getElementById('vehicleCamReset');
      if (camResetBtn) camResetBtn.onclick = () => orbit.reset();

      const ambient = new THREE.AmbientLight(0x8fa3bf, 0.6);
      scene.add(ambient);
      const key = new THREE.DirectionalLight(0xffffff, 1.1);
      key.position.copy(userToThree(2, -1, 3));
      key.castShadow = true;
      scene.add(key);
      const fill = new THREE.DirectionalLight(0x9ec5ff, 0.4);
      fill.position.copy(userToThree(-1, 2, 1.5));
      scene.add(fill);

      function makeTileFloor(size, tileCount) {
        const tilePx = 64;
        const canvas = document.createElement('canvas');
        canvas.width = tilePx * tileCount;
        canvas.height = tilePx * tileCount;
        const ctx = canvas.getContext('2d');
        const light = '#d8eaf8';
        const dark = '#b8d4f0';
        const line = 'rgba(72, 118, 168, 0.55)';
        for (let ty = 0; ty < tileCount; ty++) {
          for (let tx = 0; tx < tileCount; tx++) {
            ctx.fillStyle = (tx + ty) % 2 === 0 ? light : dark;
            ctx.fillRect(tx * tilePx, ty * tilePx, tilePx, tilePx);
          }
        }
        ctx.strokeStyle = line;
        ctx.lineWidth = 2;
        for (let i = 0; i <= tileCount; i++) {
          const p = i * tilePx + 0.5;
          ctx.beginPath();
          ctx.moveTo(p, 0);
          ctx.lineTo(p, canvas.height);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(0, p);
          ctx.lineTo(canvas.width, p);
          ctx.stroke();
        }
        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.RepeatWrapping;
        tex.repeat.set(4, 4);
        tex.anisotropy = 4;
        const floor = new THREE.Mesh(
          new THREE.PlaneGeometry(size, size),
          new THREE.MeshStandardMaterial({
            map: tex,
            roughness: 0.82,
            metalness: 0.04,
          })
        );
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = 0;
        floor.receiveShadow = true;
        return floor;
      }

      const floor = makeTileFloor(24, 8);
      scene.add(floor);

      const grid = new THREE.GridHelper(24, 24, 0xa8cce8, 0x8ab4dc);
      grid.position.y = 0.012;
      const gridMats = Array.isArray(grid.material) ? grid.material : [grid.material];
      gridMats.forEach((mat) => {
        mat.transparent = true;
        mat.opacity = 0.35;
      });
      scene.add(grid);

      const vehicleRoot = new THREE.Group();
      scene.add(vehicleRoot);

      const wheelR = 0.33;
      const wheelW = 0.26;

      const carTilt = new THREE.Group();
      vehicleRoot.add(carTilt);

      const wheelsRoot = new THREE.Group();
      vehicleRoot.add(wheelsRoot);

      const car = new THREE.Group();
      carTilt.add(car);
      car.position.copy(userToThree(-0.31, 0, -0.34));

      const blueMat = new THREE.MeshStandardMaterial({
        color: 0x1a5fd4,
        metalness: 0.35,
        roughness: 0.4,
      });
      const blackMat = new THREE.MeshStandardMaterial({
        color: 0x141820,
        metalness: 0.25,
        roughness: 0.55,
      });
      const yellowMat = new THREE.MeshStandardMaterial({
        color: 0xf2c200,
        metalness: 0.2,
        roughness: 0.45,
      });
      const tireMat = new THREE.MeshStandardMaterial({
        color: 0x1a1f28,
        metalness: 0.05,
        roughness: 0.92,
      });
      const rimMat = new THREE.MeshStandardMaterial({
        color: 0xb8c2d0,
        metalness: 0.85,
        roughness: 0.25,
      });
      const redMat = new THREE.MeshStandardMaterial({
        color: 0xd61f2a,
        metalness: 0.15,
        roughness: 0.6,
      });
      const carbonMat = new THREE.MeshStandardMaterial({
        color: 0x2a3038,
        metalness: 0.4,
        roughness: 0.35,
      });

      function makeTextMat(text, bg, fg, w, h) {
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, w, h);
        ctx.fillStyle = fg;
        ctx.font = 'bold ' + Math.floor(h * 0.72) + 'px Segoe UI, Arial, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, w / 2, h / 2);
        const tex = new THREE.CanvasTexture(canvas);
        tex.anisotropy = 4;
        return new THREE.MeshBasicMaterial({ map: tex, transparent: true });
      }

      function addUserBox(wY, hZ, dX, x, y, z, mat) {
        const mesh = new THREE.Mesh(new THREE.BoxGeometry(wY, hZ, dX), mat);
        setUserPosition(mesh, x, y, z);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        car.add(mesh);
        return mesh;
      }

      function addUserCylinder(r, len, x, y, z, mat, axis) {
        const mesh = new THREE.Mesh(new THREE.CylinderGeometry(r, r, len, 14), mat);
        setUserPosition(mesh, x, y, z);
        if (axis === 'y') {
          mesh.rotation.z = Math.PI / 2;
        } else if (axis === 'z') {
          mesh.rotation.x = 0;
        } else {
          mesh.rotation.x = Math.PI / 2;
        }
        mesh.castShadow = true;
        car.add(mesh);
        return mesh;
      }

      // A-FA 포뮬러 — w=Y폭, h=Z높이, d=X길이(전후)
      addUserBox(0.28, 0.08, 0.32, 2.28, 0, 0.14, blueMat);
      addUserBox(0.42, 0.11, 0.48, 2.02, 0, 0.18, blueMat);
      addUserBox(0.56, 0.16, 0.62, 1.68, 0, 0.24, blueMat);
      addUserBox(0.64, 0.08, 0.55, 1.68, 0, 0.34, blueMat);
      addUserBox(0.72, 0.06, 0.38, 2.12, 0, 0.12, blueMat);

      const afaLogo = new THREE.Mesh(
        new THREE.PlaneGeometry(0.24, 0.1),
        makeTextMat('A-FA', '#0d3d8c', '#ffffff', 128, 48)
      );
      setUserPosition(afaLogo, 2.26, 0, 0.18);
      car.add(afaLogo);

      const steerMat = new THREE.MeshStandardMaterial({
        color: 0x34d399,
        emissive: 0x0d3d2a,
        metalness: 0.1,
        roughness: 0.4,
      });
      const noseArrow = new THREE.Mesh(new THREE.ConeGeometry(0.07, 0.24, 10), steerMat);
      setUserPosition(noseArrow, 2.42, 0, 0.2);
      noseArrow.rotation.x = -Math.PI / 2;
      car.add(noseArrow);

      addUserBox(0.88, 0.26, 1.08, 0.82, 0, 0.34, blackMat);
      addUserBox(0.92, 0.14, 0.92, 0.05, 0, 0.4, carbonMat);
      addUserBox(0.18, 0.24, 1.42, 0.02, 0.62, 0.32, blackMat);
      addUserBox(0.18, 0.24, 1.42, 0.02, -0.62, 0.32, blackMat);
      addUserBox(0.05, 0.05, 1.15, 0.04, 0.56, 0.46, yellowMat);
      addUserBox(0.05, 0.05, 1.15, 0.04, -0.56, 0.46, yellowMat);
      addUserBox(0.05, 0.05, 0.85, 0.04, 0.56, 0.38, blueMat);
      addUserBox(0.05, 0.05, 0.85, 0.04, -0.56, 0.38, blueMat);

      addUserBox(0.5, 0.1, 0.52, 0.28, 0, 0.5, blackMat);
      addUserBox(0.36, 0.2, 0.4, 0.12, 0, 0.56, redMat);

      addUserCylinder(0.028, 0.66, -0.02, 0.3, 0.8, blackMat, 'y');
      addUserCylinder(0.028, 0.66, -0.02, -0.3, 0.8, blackMat, 'y');
      addUserCylinder(0.028, 0.54, -0.2, 0, 1.0, blackMat, 'z');
      addUserBox(0.2, 0.07, 0.14, -0.18, 0, 1.06, carbonMat);

      addUserBox(0.76, 0.3, 0.88, -0.92, 0, 0.42, blackMat);
      addUserBox(0.62, 0.22, 0.58, -1.38, 0, 0.46, blackMat);
      addUserBox(0.36, 0.4, 0.1, -1.02, 0.46, 0.54, carbonMat);

      addUserCylinder(0.022, 0.22, 1.02, 0.22, 0.48, blackMat, 'y');
      addUserCylinder(0.022, 0.22, 1.02, -0.22, 0.48, blackMat, 'y');
      addUserCylinder(0.014, 0.18, 0.78, 0.52, 0.42, yellowMat, 'z');
      addUserCylinder(0.014, 0.18, 0.78, -0.52, 0.42, yellowMat, 'z');

      addUserBox(0.7, 0.04, 0.14, 2.2, 0, 0.08, carbonMat);
      addUserBox(0.5, 0.03, 0.1, 2.24, 0, 0.05, carbonMat);

      const wheelPositions = [
        { key: 'fl', x: 1.36, y: 0.84, steer: true },
        { key: 'fr', x: 1.36, y: -0.84, steer: true },
        { key: 'rl', x: -1.04, y: 0.84, steer: false },
        { key: 'rr', x: -1.04, y: -0.84, steer: false },
      ];
      const wheels = {};
      wheelPositions.forEach((pos) => {
        addUserCylinder(0.012, 0.72, (pos.x + 0.15) * 0.5, pos.y * 0.55, 0.42, blackMat, 'y');
        const mount = new THREE.Group();
        mount.userData.base = { x: pos.x, y: pos.y };
        setUserPosition(mount, pos.x, pos.y, wheelR);
        const tire = new THREE.Mesh(
          new THREE.CylinderGeometry(wheelR, wheelR, wheelW, 22),
          tireMat
        );
        tire.rotation.z = Math.PI / 2;
        tire.castShadow = true;
        const rim = new THREE.Mesh(
          new THREE.CylinderGeometry(wheelR * 0.58, wheelR * 0.58, wheelW * 1.04, 16),
          rimMat
        );
        rim.rotation.z = Math.PI / 2;
        const hub = new THREE.Mesh(
          new THREE.CylinderGeometry(wheelR * 0.18, wheelR * 0.18, wheelW * 1.08, 6),
          rimMat
        );
        hub.rotation.z = Math.PI / 2;
        mount.add(tire);
        mount.add(rim);
        mount.add(hub);
        wheelsRoot.add(mount);
        wheels[pos.key] = { mount, tire, rim, hub, steer: pos.steer };
      });

      function resetWorld() {}

      let rafId = 0;
      vehicleDisplay = {
        pitch: 0,
        roll: 0,
        susPitch: 0,
        susRoll: 0,
        steer: 0,
        speed: 0,
        wheels: { fl: 0, fr: 0, rl: 0, rr: 0 },
      };
      vehicleTarget = {
        pitch: 0,
        roll: 0,
        susPitch: 0,
        susRoll: 0,
        steer: 0,
        speed: 0,
        wheels: { fl: 0, fr: 0, rl: 0, rr: 0 },
      };

      function resize() {
        const w = host.clientWidth || 320;
        const h = host.clientHeight || 300;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }

      function lerp(a, b, t) {
        return a + (b - a) * t;
      }

      function animate() {
        rafId = requestAnimationFrame(animate);
        const k = 0.28;
        vehicleDisplay.pitch = lerp(vehicleDisplay.pitch, vehicleTarget.pitch, k);
        vehicleDisplay.roll = lerp(vehicleDisplay.roll, vehicleTarget.roll, k);
        vehicleDisplay.susPitch = lerp(vehicleDisplay.susPitch, vehicleTarget.susPitch, k);
        vehicleDisplay.susRoll = lerp(vehicleDisplay.susRoll, vehicleTarget.susRoll, k);
        vehicleDisplay.steer = lerp(vehicleDisplay.steer, vehicleTarget.steer, k);
        ['fl', 'fr', 'rl', 'rr'].forEach((key) => {
          vehicleDisplay.wheels[key] = lerp(
            vehicleDisplay.wheels[key],
            vehicleTarget.wheels[key],
            k
          );
        });

        const steerRad = vehicleDisplay.steer * Math.PI / 180;
        const tiltMax = 0.14;
        const pitch = THREE.MathUtils.clamp(
          vehicleDisplay.pitch + vehicleDisplay.susPitch,
          -tiltMax,
          tiltMax
        );
        const roll = THREE.MathUtils.clamp(
          vehicleDisplay.roll + vehicleDisplay.susRoll,
          -tiltMax,
          tiltMax
        );

        carTilt.position.copy(userToThree(0.16, 0, wheelR));
        carTilt.quaternion.copy(quatFromUserEuler(pitch, roll, 0));

        const sus = vehicleDisplay.wheels;
        const susAvg = (sus.fl + sus.fr + sus.rl + sus.rr) * 0.25;
        car.position.copy(userToThree(-0.31, 0, -0.34 + susAvg));

        ['fl', 'fr', 'rl', 'rr'].forEach((key) => {
          const wheel = wheels[key];
          const base = wheel.mount.userData.base;
          setUserPosition(wheel.mount, base.x, base.y, wheelR);
          if (wheel.steer) {
            wheel.mount.rotation.set(0, -steerRad, 0);
          } else {
            wheel.mount.rotation.set(0, 0, 0);
          }
        });

        renderer.render(scene, camera);
      }

      const ro = new ResizeObserver(resize);
      ro.observe(host);
      resize();
      animate();

      vehicleViz = {
        resetWorld,
        resetCamera: () => orbit.reset(),
        destroy() {
          cancelAnimationFrame(rafId);
          orbit.dispose();
          ro.disconnect();
          renderer.dispose();
          if (renderer.domElement.parentNode) {
            renderer.domElement.parentNode.removeChild(renderer.domElement);
          }
          vehicleViz = null;
        },
      };
      return vehicleViz;
    }

    function destroyVehicleViz() {
      if (vehicleViz) vehicleViz.destroy();
      vehicleViz = null;
      vehicleTarget = null;
      vehicleDisplay = null;
    }

    function applyVehicleSnapshot(values) {
      if (!values) return;
      ensureVehicleViz();
      if (!vehicleTarget) return;

      const ax = numOr(values.accelX, 0);
      const ay = numOr(values.accelY, 0);
      const az = numOr(values.accelZ, 1);

      const vis = visCfg();
      const pitchGain = Number(vis.pitch_gain || 0.22);
      const rollGain = Number(vis.roll_gain || 0.35);
      const tiltMax = Number(vis.tilt_max_deg || 10) * Math.PI / 180;
      const susGain = Number(vis.sus_gain || 0.85);
      const susTiltMax = Number(vis.sus_tilt_max_deg || 6) * Math.PI / 180;

      if (values.pitch_deg != null && values.roll_deg != null) {
        vehicleTarget.pitch = THREE.MathUtils.clamp(
          numOr(values.pitch_deg, 0) * Math.PI / 180 * pitchGain,
          -tiltMax,
          tiltMax
        );
        vehicleTarget.roll = THREE.MathUtils.clamp(
          numOr(values.roll_deg, 0) * Math.PI / 180 * rollGain,
          -tiltMax,
          tiltMax
        );
      } else {
        const gz = Math.abs(az) > 0.15 ? az : 1;
        const gravMix = Math.max(0.35, 1 - Math.max(0, Math.abs(ax) - 0.18) / 0.55);
        const axTilt = ax * gravMix;
        vehicleTarget.pitch = THREE.MathUtils.clamp(Math.atan2(-axTilt, gz) * pitchGain, -tiltMax, tiltMax);
        vehicleTarget.roll = THREE.MathUtils.clamp(Math.atan2(ay, gz) * rollGain, -tiltMax, tiltMax);
      }

      vehicleTarget.steer = numOr(values.steering_angle, 0);
      vehicleTarget.speed = Math.max(0, numOr(values.speed, 0));

      const neutral = Number(linCfg().neutral_mm || 40);
      const lin = {
        fl: numOr(values.linear_fl, neutral),
        fr: numOr(values.linear_fr, neutral),
        rl: numOr(values.linear_rl, neutral),
        rr: numOr(values.linear_rr, neutral),
      };
      const avg = (lin.fl + lin.fr + lin.rl + lin.rr) / 4;
      const susScale = Number(linCfg().visual_scale || 0.022);
      const wOff = {
        fl: (avg - lin.fl) * susScale,
        fr: (avg - lin.fr) * susScale,
        rl: (avg - lin.rl) * susScale,
        rr: (avg - lin.rr) * susScale,
      };
      vehicleTarget.wheels.fl = wOff.fl;
      vehicleTarget.wheels.fr = wOff.fr;
      vehicleTarget.wheels.rl = wOff.rl;
      vehicleTarget.wheels.rr = wOff.rr;

      if (values.sus_pitch_deg != null && values.sus_roll_deg != null) {
        vehicleTarget.susPitch = THREE.MathUtils.clamp(
          numOr(values.sus_pitch_deg, 0) * Math.PI / 180,
          -susTiltMax,
          susTiltMax
        );
        vehicleTarget.susRoll = THREE.MathUtils.clamp(
          numOr(values.sus_roll_deg, 0) * Math.PI / 180,
          -susTiltMax,
          susTiltMax
        );
      } else {
        const wheelbase = Number((vehicleSpec && vehicleSpec.wheelbase_m) || 2.4);
        const track = Number((vehicleSpec && vehicleSpec.track_m) || 1.68);
        const front = (wOff.fl + wOff.fr) * 0.5;
        const rear = (wOff.rl + wOff.rr) * 0.5;
        const left = (wOff.fl + wOff.rl) * 0.5;
        const right = (wOff.fr + wOff.rr) * 0.5;
        vehicleTarget.susPitch = THREE.MathUtils.clamp(
          Math.atan2(rear - front, wheelbase) * susGain,
          -susTiltMax,
          susTiltMax
        );
        vehicleTarget.susRoll = THREE.MathUtils.clamp(
          Math.atan2(right - left, track) * susGain,
          -susTiltMax,
          susTiltMax
        );
      }

      document.getElementById('vsSpeed').textContent = vehicleTarget.speed.toFixed(1);
      document.getElementById('vsAccel').textContent =
        'X ' + ax.toFixed(2) + ' · Y ' + ay.toFixed(2) + ' · Z ' + az.toFixed(2);
      document.getElementById('vsSteer').textContent = vehicleTarget.steer.toFixed(1) + '°';
      const pitchDeg = values.pitch_deg != null
        ? numOr(values.pitch_deg, 0) + numOr(values.sus_pitch_deg, 0)
        : (vehicleTarget.pitch + vehicleTarget.susPitch) * 180 / Math.PI;
      const rollDeg = values.roll_deg != null
        ? numOr(values.roll_deg, 0) + numOr(values.sus_roll_deg, 0)
        : (vehicleTarget.roll + vehicleTarget.susRoll) * 180 / Math.PI;
      document.getElementById('vsAttitude').textContent =
        '피치 ' + pitchDeg.toFixed(1) + '° · 롤 ' + rollDeg.toFixed(1) + '°';
      document.getElementById('vsLinear').textContent =
        lin.fl.toFixed(1) + ' / ' + lin.fr.toFixed(1) + ' / ' +
        lin.rl.toFixed(1) + ' / ' + lin.rr.toFixed(1);
    }

    async function refreshVehicle() {
      if (!sessionId) return;
      try {
        const t = player.currentTime || 0;
        const offset = Number(offsetRange.value || 0);
        const url = '/api/session/' + sessionId + '/snapshot'
          + '?t=' + encodeURIComponent(t)
          + '&offset=' + encodeURIComponent(offset);
        const data = await fetch(url, { cache: 'no-store' }).then((r) => r.json());
        if (!data.ok) return;
        applyVehicleSnapshot(data.values || {});
      } catch (err) {
        // vehicle viz is best-effort
      }
    }

    document.getElementById('uploadForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const csv = document.getElementById('csvInput').files[0];
      const video = document.getElementById('videoInput').files[0];
      if (!csv || !video) {
        setStatus('CSV와 영상을 모두 선택하세요.', 'err');
        return;
      }
      const btn = document.getElementById('uploadBtn');
      btn.disabled = true;
      setStatus('업로드 중...');
      try {
        const body = new FormData();
        body.append('csv_file', csv);
        body.append('video_file', video);
        const res = await fetch('/api/upload', { method: 'POST', body });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          const detail = data.detail;
          const msg = Array.isArray(detail)
            ? detail.map((d) => d.msg || JSON.stringify(d)).join('; ')
            : (detail || data.message || 'upload failed');
          throw new Error(msg);
        }
        sessionId = data.session_id;
        updateVehicleActionButtons();
        sessionT0 = Number(data.t0 || 0);
        sessionEvents = [];
        sessionSegments = [];
        selectedSegmentIds = new Set();
        compareMode = false;
        workspace.hidden = false;
        document.getElementById('clearBtn').disabled = false;
        document.getElementById('autosyncBtn').disabled = false;
        document.getElementById('metaCsv').textContent = 'CSV: ' + data.csv_name;
        document.getElementById('metaVideo').textContent = 'Video: ' + data.video_name;
        document.getElementById('metaRows').textContent = 'rows: ' + data.row_count;
        document.getElementById('metaDur').textContent = 'csv span: ' + Number(data.duration_sec || 0).toFixed(1) + 's';
        document.getElementById('metaT0').textContent = 't0: ' + (data.t0_label || '-');
        renderColumns(data.columns || []);
        updatePpBadge(data.postprocess || { status: 'pending' });
        renderKpi(null);
        document.getElementById('eventsList').innerHTML = '<div class="hint">후처리 중...</div>';
        document.getElementById('segmentsList').innerHTML = '<div class="hint">후처리 중...</div>';
        document.getElementById('kpiGrid').innerHTML = '';
        player.src = data.video_url + '?_=' + Date.now();
        player.load();
        const syncMsg = applySyncInfo(data.sync || {}, data.duration_sec);
        setStatus('업로드 완료 · 후처리 시작 · ' + syncMsg, (data.sync && data.sync.ok) ? 'ok' : '');
        destroyVehicleViz();
        ensureVehicleViz();
        if (vehicleViz && vehicleViz.resetWorld) vehicleViz.resetWorld();
        pollPostprocess();
        scheduleRefresh(true);
      } catch (err) {
        setStatus('업로드 실패: ' + (err.message || err), 'err');
      } finally {
        btn.disabled = false;
      }
    });

    document.getElementById('clearBtn').addEventListener('click', async () => {
      if (!sessionId) return;
      try {
        await fetch('/api/session/' + sessionId, { method: 'DELETE' });
      } catch (err) {}
      sessionId = '';
      updateVehicleActionButtons();
      sessionT0 = 0;
      sessionEvents = [];
      sessionSegments = [];
      selectedSegmentIds = new Set();
      compareMode = false;
      if (ppTimer) clearTimeout(ppTimer);
      player.removeAttribute('src');
      player.load();
      workspace.hidden = true;
      document.getElementById('clearBtn').disabled = true;
      document.getElementById('autosyncBtn').disabled = true;
      if (chart) {
        chart.destroy();
        chart = null;
      }
      destroyVehicleViz();
      setStatus('세션을 삭제했습니다.');
    });

    document.getElementById('autosyncBtn').addEventListener('click', async () => {
      if (!sessionId) return;
      const btn = document.getElementById('autosyncBtn');
      btn.disabled = true;
      setStatus('영상 HUD 시간 인식 중...');
      try {
        const res = await fetch('/api/session/' + sessionId + '/autosync', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          throw new Error(data.detail || data.message || 'autosync failed');
        }
        const durText = document.getElementById('metaDur').textContent || '';
        const durMatch = durText.match(/([\d.]+)s/);
        const durationSec = durMatch ? Number(durMatch[1]) : 0;
        const syncMsg = applySyncInfo(data.sync || {}, durationSec);
        setStatus(syncMsg, (data.sync && data.sync.ok) ? 'ok' : '');
        scheduleRefresh(true);
      } catch (err) {
        setStatus('자동 동기화 실패: ' + (err.message || err), 'err');
      } finally {
        btn.disabled = false;
      }
    });

    offsetRange.addEventListener('input', () => {
      compareMode = false;
      document.getElementById('offsetLabel').textContent = Number(offsetRange.value).toFixed(1);
      scheduleRefresh(true);
    });
    windowRange.addEventListener('input', () => {
      compareMode = false;
      document.getElementById('windowLabel').textContent = String(windowRange.value);
      scheduleRefresh(true);
    });

    ['timeupdate', 'seeked', 'play', 'pause'].forEach((ev) => {
      player.addEventListener(ev, () => {
        if (ev === 'seeked') compareMode = false;
        if (ev === 'seeked' && vehicleViz && vehicleViz.resetWorld) {
          vehicleViz.resetWorld();
        }
        scheduleRefresh(ev !== 'timeupdate');
      });
    });

    document.getElementById('vehicleSpecForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      await saveVehicleSpecFromForm();
    });
    document.getElementById('vehicleReprocessBtn').addEventListener('click', reprocessCurrentSession);
    document.getElementById('vehicleSpecToggle').addEventListener('click', () => {
      const form = document.getElementById('vehicleSpecForm');
      const collapsed = !form.hidden;
      form.hidden = collapsed;
      document.getElementById('vehicleSpecToggle').textContent = collapsed ? '펼치기' : '접기';
    });
  </script>
</body>
</html>
