# 공개 호스트 (nginx path reverse proxy)
AFA_PUBLIC_HOST=<SERVER_HOST>
AFA_PUBLIC_SCHEME=https

# 내부 listen 포트
LOGGER_PORT=8000
REALTIME_PORT=8011
CAMERA_PORT=8012
ANALYSIS_PORT=8013

# 공개 URL (포트 직접 노출 아님 — nginx path)
LOGGER_URL=https://<SERVER_HOST>
REALTIME_URL=https://<SERVER_HOST>/live/
CAMERA_URL=https://<SERVER_HOST>/camera/
ANALYSIS_URL=https://<SERVER_HOST>/analysis/
CAMERA_PUBLIC_BASE_URL=https://<SERVER_HOST>/camera

# 로그인
AFA_AUTH_ENABLED=1
AFA_AUTH_USERNAME=<USERNAME>
AFA_AUTH_PASSWORD=<CHANGE_ME>
AFA_AUTH_SESSION_HOURS=24
# 동일 도메인 path 프록시: SSO 끄기 (켜면 네비가 로깅으로 튕김)
AFA_AUTH_SSO=0

# 서버 간 내부 연동 (루프백)
FORWARD_URL=http://127.0.0.1:8011/api/live/ingest
MONITOR_FORWARD_URL=http://127.0.0.1:8011/api/live/ingest
LOGGER_INTERNAL_URL=http://127.0.0.1:8000
CAMERA_INTERNAL_URL=http://127.0.0.1:8012
LOGGER_SNAPSHOT_URL=http://127.0.0.1:8011/api/live/snapshot

ENABLE_UDP=1
UDP_BIND_PORT=9999

SAMPLE_TIMES_MAXLEN=2500
REALTIME_PACKET_TIMES_MAXLEN=500
REALTIME_EVENTS_MAXLEN=16
DEVICE_CACHE_MAX=8
FORWARD_QUEUE_MAX=32
LOG_QUEUE_MAX_ROWS=400
LIVE_TASK_MAX=12
COMPLETED_DOWNLOADS_MAX=2
LOG_ENQUEUE_BATCH_SIZE=32
LOG_FLUSH_INTERVAL_SEC=2.0
LOG_MAX_DIR_BYTES=268435456
LOG_MIN_FREE_BYTES=67108864
LOG_DELETE_AFTER_DOWNLOAD=1
LOG_DOWNLOAD_GZIP=1
# CSV 목표 저장 주파수 (수신 200Hz여도 100Hz만 기록)
LOG_TARGET_HZ=100

UVICORN_LOG_LEVEL=warning
UVICORN_ACCESS_LOG=0

# RTSP 녹화
CAMERA_RECORD_MODE=rtsp
CAMERA_RTSP_URL=rtsp://127.0.0.1:8554/cam
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_RTSP_SEGMENT_SECONDS=0
CAMERA_RTSP_PREVIEW=1
CAMERA_RTSP_PREVIEW_INTERVAL_SEC=1.0
CAMERA_RTCP_PROBE_TIMEOUT_SEC=12
CAMERA_MAX_RECORDING_BYTES=2147483648
# 2시간 @ 24fps (RTSP는 동일 예산을 시간으로 적용)
CAMERA_MAX_RECORD_FRAMES=172800
CAMERA_MIN_FREE_BYTES=67108864
CAMERA_RECORD_ZIP=0
CAMERA_TELEMETRY_POLL_MS=1000
CAMERA_PREVIEW_POLL_MS=500
CAMERA_MAX_FRAME_BYTES=1048576

LINK_CAMERA_RECORDING=1
# Pi outbound sync API용 장치 토큰 (서버와 Pi에 동일한 긴 랜덤 값 설정)
CAMERA_SYNC_SERVER_TOKEN=<LONG_RANDOM_TOKEN>
CAMERA_SYNC_DEVICE=raspberry-pi-camera
INGEST_DEDUP_RETENTION_DAYS=30
INGEST_V2_DB_PATH=/home/afa/다운로드/afa2026-main/server/udp_logger/logs/ingest_v2.sqlite3
START_REALTIME=1
START_MEDIAMTX=1
ANALYSIS_MAX_SESSION_BYTES=1610612736
ANALYSIS_MAX_SESSIONS=8
CAMERA_HFLIP=1
LINEAR_SWAP_FL_RR=0
