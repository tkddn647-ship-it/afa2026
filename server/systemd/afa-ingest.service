[Unit]
Description=AFA Logging Server (udp_logger)
After=network.target

[Service]
Type=simple
User=afa
WorkingDirectory=/home/afa/다운로드/afa2026-main/server/udp_logger
EnvironmentFile=/home/afa/다운로드/afa2026-main/server/env.ingest
Environment=PATH=/home/afa/다운로드/afa2026-main/server/.venv/bin:/usr/local/bin:/usr/bin
Environment=PYTHONPATH=/home/afa/다운로드/afa2026-main/server
ExecStart=/home/afa/다운로드/afa2026-main/server/.venv/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
