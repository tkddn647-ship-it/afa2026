[Unit]
Description=AFA Realtime Monitor (realtime_server)
After=network.target afa-ingest.service

[Service]
Type=simple
User=afa
WorkingDirectory=/home/afa/다운로드/afa2026-main/server/udp_realtime
EnvironmentFile=/home/afa/다운로드/afa2026-main/server/env.ingest
Environment=PATH=/home/afa/다운로드/afa2026-main/server/.venv/bin:/usr/local/bin:/usr/bin
Environment=PYTHONPATH=/home/afa/다운로드/afa2026-main/server
Environment=PORT=8011
ExecStart=/home/afa/다운로드/afa2026-main/server/.venv/bin/python3 -m uvicorn realtime_server:app --host 0.0.0.0 --port 8011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
